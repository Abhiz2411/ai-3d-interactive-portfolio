# Copy to .env (gitignored). On the server these live in /etc/aichat.env.
GEMINI_API_KEY=
# Local development: bypass the launch gate
DEV_OPEN=1
# Random strings; generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
IP_SALT=
OWNER_TOKEN=
# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# LIMIT_PER_IP_PER_DAY=15
# LIMIT_GLOBAL_PER_DAY=350
# LAUNCH_AT=2026-11-24T00:00:00+05:30
